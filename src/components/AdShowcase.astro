---
// Example ad layouts. Suburbs and "Your Name" are placeholders; photos are drawn shapes.
const ads = [
  { k: "video", t: "Video ad", d: "You on camera, scripted and directed by us." },
  { k: "val", t: "Free valuation", d: "A bold square for homeowners, one per suburb." },
  { k: "buyers", t: "Buyers waiting", d: "A clean portrait with your photo." },
  { k: "story", t: "Market update story", d: "A tall story with one big statement." },
  { k: "sold", t: "Just sold", d: "A listing photo with a sold banner." },
  { k: "banner", t: "Ready to sell", d: "The suburb in a bold band, with an address box." },
] as const;
---
<div class="wrapads">
<div class="ads">
  {ads.map((a) => (
    <figure class={`ad ${a.k}`}>
      <div class="frame" aria-hidden="true">
        {a.k === "video" && (
          <div class="vid">
            <img src="/ads/video-ad.jpg" alt="" loading="lazy" width="640" height="640" />
            <span class="play"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
          </div>
        )}
        {a.k === "val" && (
          <div class="val-in">
            <small>Klein Windhoek homeowners</small>
            <b>What is your home worth today?</b>
            <i>Free, no-obligation valuation from Your Name</i>
            <span class="pill">Book my valuation</span>
          </div>
        )}
        {a.k === "buyers" && (
          <div class="buy-in">
            <b>We have buyers waiting in Eros</b>
            <i>Selling soon? Your Name has qualified buyers looking for homes like yours.</i>
            <div class="row"><div class="photo person"></div><div class="card"><strong>Your Name</strong><span>Your Agency</span></div></div>
          </div>
        )}
        {a.k === "story" && (
          <div class="story-in">
            <small>Market update</small>
            <b>Ludwigsdorf homes are selling fast.</b>
            <i>Find out what yours could sell for.</i>
            <span class="pill dark">Swipe up to book</span>
          </div>
        )}
        {a.k === "sold" && (
          <div class="sold-in">
            <div class="photo house"></div>
            <div class="band"><small>Just sold</small><b>Eros Park</b><i>Thinking of selling? Your Name can do the same for you.</i></div>
          </div>
        )}
        {a.k === "banner" && (
          <div class="ban-in">
            <div class="photo sky"></div>
            <small>Ready to sell your home in</small>
            <b>WINDHOEK</b>
            <em>Check your home's estimated selling price</em>
            <span class="addr">Enter your address here…</span>
          </div>
        )}
      </div>
      <figcaption><strong>{a.t}</strong><span>{a.d}</span></figcaption>
    </figure>
  ))}
</div>
<p class="note">Examples. Suburbs and names are placeholders; your ads use your photo, brand and areas.</p>
</div>

<style>
  .ads { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; }
  @media (max-width: 760px) { .ads { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ad { margin: 0; }
  .frame { aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden; position: relative; border: 1px solid var(--line); }
  figcaption { margin-top: 10px; font-size: .92rem; line-height: 1.35; }
  figcaption strong { display: block; }
  figcaption span { color: var(--grey); }
  .note { margin-top: 18px; color: var(--grey); font-size: .82rem; }

  .frame small { font-size: .55rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .8; }
  .frame b { display: block; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .frame i { font-style: normal; font-size: .62rem; line-height: 1.35; opacity: .8; display: block; }
  .pill { display: inline-block; background: #fff; color: #111; font-size: .6rem; font-weight: 700; padding: 6px 11px; border-radius: 99px; }
  .pill.dark { background: #3a3a3a; color: #fff; }
  .photo { background: linear-gradient(160deg, #cfcfcf, #8f8f8f); }
  .photo.person { background: radial-gradient(circle at 50% 36%, #9a9a9a 0 17%, transparent 18%), radial-gradient(ellipse at 50% 98%, #9a9a9a 0 38%, transparent 39%), #d6d6d6; }
  .photo.house { background: linear-gradient(#b9c9d6 0 52%, #8b9a7a 52%); }
  .photo.house::before { content: ""; position: absolute; left: 18%; top: 22%; width: 64%; height: 22%; background: #5a5a5a; clip-path: polygon(0 100%, 50% 0, 100% 100%); }
  .photo.house::after { content: ""; position: absolute; left: 24%; top: 43%; width: 52%; height: 32%; background: linear-gradient(90deg, #f2f2f2 0 40%, #6b7d8c 40% 58%, #f2f2f2 58%); }
  .photo.sky { position: absolute; inset: 0; background: linear-gradient(#7fa6c4 0 45%, #6f8a5a 45% 70%, #4e6340); }

  .vid { position: absolute; inset: 0; background: #111; }
  .vid img { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 52px; height: 52px; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; display: grid; place-items: center; }

  .val .frame { background: #4a4a4a; color: #fff; }
  .val-in { position: absolute; inset: 0; padding: 18px; display: flex; flex-direction: column; justify-content: center; gap: 8px; background: radial-gradient(circle at 95% 0%, #5c5c5c 0 30%, transparent 31%); }
  .val-in b { font-size: 1.25rem; }

  .buyers .frame { background: #f3f1ec; color: #1a1a1a; }
  .buy-in { position: absolute; inset: 0; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  .buy-in b { font-size: 1.05rem; }
  .buy-in .row { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-items: end; }
  .buy-in .person { aspect-ratio: 3 / 4; border-radius: 6px; }
  .buy-in .card { background: #2e2e2e; color: #fff; border-radius: 6px; padding: 8px; font-size: .6rem; line-height: 1.3; }
  .buy-in .card strong { display: block; }

  .story .frame { background: #121212; color: #fff; }
  .story-in { position: absolute; inset: 0; padding: 18px; display: flex; flex-direction: column; justify-content: center; gap: 8px; background: radial-gradient(circle at 10% 105%, #2a2a2a 0 40%, transparent 41%); }
  .story-in b { font-size: 1.3rem; }
  .story-in .pill { margin-top: 14px; text-align: center; }

  .sold .frame { background: #ddd; }
  .sold-in { position: absolute; inset: 0; }
  .sold-in .house { position: absolute; inset: 0 0 34% 0; }
  .sold-in .band { position: absolute; left: 0; right: 0; bottom: 0; height: 34%; background: #4a4a4a; color: #fff; padding: 10px 14px; display: flex; flex-direction: column; justify-content: center; gap: 3px; }
  .sold-in .band b { font-size: 1.05rem; }

  .banner .frame { color: #fff; }
  .ban-in { position: absolute; inset: 0; padding: 16px 10px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .ban-in > *:not(.photo) { position: relative; }
  .ban-in small { margin-top: 6px; text-shadow: 0 1px 4px rgba(0,0,0,.5); opacity: 1; }
  .ban-in b { background: #fff; color: #111; width: calc(100% + 20px); padding: 6px 0; font-size: 1.45rem; letter-spacing: 0; }
  .ban-in em { font-style: normal; font-weight: 800; font-size: .66rem; text-transform: uppercase; text-shadow: 0 1px 4px rgba(0,0,0,.6); }
  .ban-in .addr { background: #fff; color: #555; font-size: .6rem; font-weight: 600; border-radius: 99px; padding: 7px 12px; width: 88%; text-align: left; }
</style>
