---
// Line drawing of a street of houses for the hero background, with a few red pins
// dropping onto homes ("sellers in your area"). Generated, so no image files.
const W = 1600, G = 230; // viewBox width, ground line
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

type House = { x: number; w: number; h: number; roof: "gable" | "flat" | "hip"; pin: boolean };
const houses: House[] = [];
const pinAt = new Set([2, 6, 10]);
let x = -20, i = 0;
while (x < W + 20) {
  const w = 90 + Math.round(rnd() * 80);
  const h = 55 + Math.round(rnd() * 55);
  const r = rnd();
  houses.push({ x, w, h, roof: r < 0.45 ? "gable" : r < 0.75 ? "flat" : "hip", pin: pinAt.has(i) });
  x += w + 18 + Math.round(rnd() * 40);
  i++;
}
const trees = houses.slice(0, -1).filter((_, k) => k % 3 === 1).map((hs) => ({ x: hs.x + hs.w + 9, h: 40 + Math.round(rnd() * 30) }));

function roofPath(hs: House) {
  const top = G - hs.h;
  if (hs.roof === "gable") return `M${hs.x - 8} ${top} L${hs.x + hs.w / 2} ${top - 38} L${hs.x + hs.w + 8} ${top}`;
  if (hs.roof === "hip") return `M${hs.x - 8} ${top} L${hs.x + hs.w * 0.28} ${top - 26} L${hs.x + hs.w * 0.72} ${top - 26} L${hs.x + hs.w + 8} ${top}`;
  return `M${hs.x - 6} ${top} L${hs.x + hs.w + 6} ${top} L${hs.x + hs.w + 6} ${top - 8} L${hs.x - 6} ${top - 8} Z`;
}
function roofTop(hs: House) { const top = G - hs.h; return hs.roof === "gable" ? top - 38 : hs.roof === "hip" ? top - 26 : top - 8; }
---
<div class="scape" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${G + 6}`} preserveAspectRatio="xMidYMax slice">
    <g class="line">
      {houses.map((hs) => (
        <g>
          <rect x={hs.x} y={G - hs.h} width={hs.w} height={hs.h} />
          <path d={roofPath(hs)} />
          <rect x={hs.x + hs.w * 0.16} y={G - hs.h + 16} width={hs.w * 0.2} height={16} />
          <rect x={hs.x + hs.w * 0.64} y={G - hs.h + 16} width={hs.w * 0.2} height={16} />
          {hs.h > 70 && <rect x={hs.x + hs.w * 0.42} y={G - 34} width={hs.w * 0.16} height={34} />}
        </g>
      ))}
      {trees.map((t) => (
        <g>
          <line x1={t.x} y1={G} x2={t.x} y2={G - t.h + 14} />
          <circle cx={t.x} cy={G - t.h} r={14} />
        </g>
      ))}
      <line x1="0" y1={G} x2={W} y2={G} />
    </g>
    {houses.filter((hs) => hs.pin).map((hs, k) => (
      <g class="pin" style={`--k:${k}`} transform={`translate(${hs.x + hs.w / 2} ${roofTop(hs) - 10})`}>
        <path d="M0 0 C -11 -12, -15 -20, -15 -27 A 15 15 0 1 1 15 -27 C 15 -20, 11 -12, 0 0 Z" />
        <circle cx="0" cy="-27" r="5.5" />
      </g>
    ))}
  </svg>
</div>

<style>
  .scape { position: absolute; left: 0; right: 0; bottom: 0; height: clamp(130px, 15vw, 210px); pointer-events: none; z-index: 0; }
  .scape svg { width: 100%; height: 100%; display: block; }
  .line { fill: none; stroke: #dcdcdc; stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .line rect, .line path, .line circle { fill: var(--paper); }
  .pin path { fill: var(--red); }
  .pin circle { fill: var(--paper); }
  .pin { animation: drop .6s cubic-bezier(.2, .9, .3, 1.3) both; animation-delay: calc(.9s + var(--k) * .35s); }
  @keyframes drop { from { opacity: 0; translate: 0 -40px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .pin { animation: none; } }
</style>
