---
import Logo from "./Logo.astro";
interface Props { booking?: boolean }
const { booking = false } = Astro.props;
---
<header>
  <div class="wrap bar">
    <a href="/" class="home" aria-label="AgentFlow home"><Logo /></a>
    {booking
      ? <a href="/" class="back">Back to home</a>
      : <a href="/pitch" class="btn small">Book a call</a>}
  </div>
</header>

<style>
  .bar { display: flex; justify-content: space-between; align-items: center; height: 76px; }
  .home { text-decoration: none; }
  .back { color: var(--grey); text-decoration: none; font-size: .95rem; }
  .back:hover { color: var(--ink); }
</style>
