---
import Logo from "./Logo.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
];
---
<header class="nav">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="AgentFlow home"><Logo /></a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
      <a href="/pitch" class="btn btn-primary call">Book a call</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: rgba(11, 19, 34, 0.82);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .home { text-decoration: none; }
  nav { display: flex; align-items: center; gap: clamp(.9rem, 3vw, 2rem); }
  nav a:not(.btn) { text-decoration: none; color: var(--muted); font-weight: 550; font-size: .95rem; }
  nav a:not(.btn):hover, nav a[aria-current="page"] { color: var(--text); }
  .call { padding: .6rem 1rem; font-size: .9rem; }
  @media (max-width: 520px) {
    nav a[href="/"] { display: none; }
    .call { padding: .55rem .8rem; }
  }
</style>
