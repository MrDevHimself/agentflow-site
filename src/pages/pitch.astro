---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { offer } from "../offer";
import { LEAD_LOG_URL, CALENDLY_URL, GOOGLE_BOOKING_URL, LISTINGS_OPTIONS, NOT_YET, TOWNS } from "../booking";

const whatsapp = `https://wa.me/264818226779?text=${encodeURIComponent("Hey there, just booked a strategy call, looking forward to it.")}`;
const whatsappNotYet = `https://wa.me/264818226779?text=${encodeURIComponent("Hi, I'd like to hear when AgentFlow opens up to more agents.")}`;
const usesCalendly = CALENDLY_URL !== "";
---
<Base title="Book a free call · AgentFlow" description={`Watch the 1-minute breakdown, then book a free 30-minute call. ${offer.booking}`}>
  <Nav booking />
  <main class="wrap">
    <div class="intro">
      <h1 class="display">See if your spot's open.</h1>
      <p class="lede">Watch the 1-minute breakdown, answer a few quick questions, then book a free 30-minute call. {offer.booking} <strong class="hot">Spots are limited.</strong></p>
    </div>

    <p class="step">1. Watch how it works</p>
    <div class="video">
      <video controls playsinline preload="metadata" poster="/video/the-split.jpg">
        <source src="/video/the-split.mp4" type="video/mp4" />
      </video>
    </div>

    <p class="step">2. Check you qualify</p>
    <p class="note">We work with established agents in Windhoek and at the coast: at least 3 listings taken on in the last 6 months. Three quick steps, about a minute.</p>

    <form id="qualify" class="form" novalidate data-log={LEAD_LOG_URL} data-notyet={NOT_YET}>
      <div class="progress" aria-live="polite">
        <span>Step <b id="stepn">1</b> of 3</span>
        <div class="pbar"><i id="pfill"></i></div>
      </div>

      <div class="pane" data-pane="1">
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Mobile number (WhatsApp)<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
        <div class="nav"><button class="btn" type="button" data-next>Next</button></div>
      </div>

      <div class="pane" data-pane="2" hidden>
        <fieldset>
          <legend>Your role</legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="role" value="Principal or agency owner" required /> Principal or agency owner</label>
            <label class="choice"><input type="radio" name="role" value="Agent at an agency" /> Agent at an agency</label>
            <label class="choice"><input type="radio" name="role" value="Independent agent" /> Independent agent</label>
          </div>
        </fieldset>
        <label>Where do you mainly sell?
          <select name="town" required>
            <option value="">Choose one</option>
            {TOWNS.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label>Your agency, and the areas or suburbs you cover<input name="agency" placeholder="e.g. Example Realty, Klein Windhoek and Eros" required /></label>
        <label>How many listings have you taken on in the last 6 months?
          <select name="listings" required>
            <option value="">Choose one</option>
            {LISTINGS_OPTIONS.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <div class="nav"><button class="back" type="button" data-back>Back</button><button class="btn" type="button" data-next>Next</button></div>
      </div>

      <div class="pane" data-pane="3" hidden>
        <fieldset>
          <legend>Your ads run from your own Facebook account, so you pay Facebook directly for the ad spend, from N$1,500 a month. Is that OK for you?</legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="adspend" value="Yes" required /> Yes</label>
            <label class="choice"><input type="radio" name="adspend" value="No" /> No</label>
            <label class="choice"><input type="radio" name="adspend" value="Want to discuss" /> Want to discuss</label>
          </div>
        </fieldset>
        <label>Email<span class="hint">For your call invite</span><input name="email" type="email" autocomplete="email" required /></label>
        <label><span>Link to your agent profile <span class="opt">(optional)</span></span><span class="hint">Property24, HouseFinder, your agency's website or Facebook page</span><input name="profile" inputmode="url" autocapitalize="off" /></label>
        <div class="nav"><button class="back" type="button" data-back>Back</button><button class="btn" type="submit">Pick a time</button></div>
      </div>

      <p class="err" id="err" role="alert" hidden>Please fill in the fields marked in red.</p>
      <p class="fine">Your answers save as you go, so we can follow up if something goes wrong. See our <a href="/privacy">privacy policy</a>.</p>
    </form>

    <div id="notyet" class="notyet" hidden>
      <h2>Thanks, you're not quite there yet.</h2>
      <p>Right now we're only taking on agents with at least 3 listings in the last 6 months, so we can give each one our full attention. Message us and we'll let you know when we open up.</p>
      <a class="btn wa" href={whatsappNotYet} target="_blank" rel="noopener">Message us on WhatsApp</a>
    </div>

    <div id="pick" hidden>
      <p class="step">3. Pick a time</p>
      <div class="embed">
        <iframe id="cal" title="Book a strategy call with AgentFlow" data-calendly={CALENDLY_URL} data-google={GOOGLE_BOOKING_URL}></iframe>
      </div>
      <p class="fine">By booking, you agree that we can use your details to arrange your call, as set out in our <a href="/privacy">privacy policy</a>.</p>
    </div>

    <section class="part after">
      <h2>After you book</h2>
      <ol class="items">
        <li><Icon name="mail" /><div><strong>1. Check your email</strong><span class="d">{usesCalendly ? "Calendly" : "Google"} sends you a confirmation with the call link. Look in Spam if it's not there.</span></div></li>
        <li><Icon name="cal" /><div><strong>2. Save it to your calendar</strong><span class="d">The invite is already attached. Tap Yes so you don't miss it.</span></div></li>
        <li>
          <Icon name="chat" />
          <div>
            <strong>3. Confirm on WhatsApp</strong><span class="d">Send us a quick message so we know you're coming.</span>
            <a class="btn wa" href={whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>
          </div>
        </li>
      </ol>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.getElementById("qualify") as HTMLFormElement;
  const logUrl = form.dataset.log || "";
  const notYet = form.dataset.notyet || "";
  const labels: Record<string, string> = {
    name: "Name", phone: "Mobile number", role: "Role", town: "Town",
    agency: "Agency and areas", listings: "Listings in 6 months",
    adspend: "Ad spend question", email: "Email", profile: "Profile link",
  };
  const panes = Array.from(form.querySelectorAll<HTMLElement>(".pane"));
  const err = document.getElementById("err")!;

  let sid = "";
  try { sid = sessionStorage.getItem("af_sid") || ""; } catch {}
  if (!sid) {
    sid = (crypto.randomUUID?.() || String(Date.now()) + Math.random().toString(16).slice(2));
    try { sessionStorage.setItem("af_sid", sid); } catch {}
  }

  let step = 1;
  let at = "";
  let status = "Started";
  let timer: number | undefined;

  function values() {
    const fd = new FormData(form);
    const out: Record<string, string> = {};
    for (const k of Object.keys(labels)) out[k] = String(fd.get(k) ?? "").trim();
    return out;
  }

  function send() {
    if (!logUrl) return;
    const v = values();
    if (!Object.values(v).some((x) => x !== "") && status === "Started") return;
    const body = JSON.stringify({ sid, values: v, at, status });
    // text/plain keeps this a "simple" request, so Google's web app accepts it.
    fetch(logUrl, { method: "POST", mode: "no-cors", keepalive: true, headers: { "Content-Type": "text/plain" }, body }).catch(() => {});
  }

  function later() {
    clearTimeout(timer);
    timer = window.setTimeout(send, 800);
  }

  form.addEventListener("focusin", (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name && labels[el.name]) at = labels[el.name];
  });
  form.addEventListener("input", later);
  form.addEventListener("change", later);
  addEventListener("pagehide", () => { clearTimeout(timer); send(); });

  function checkPane(pane: HTMLElement) {
    let ok = true;
    pane.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]").forEach((el) => {
      const isRadio = el instanceof HTMLInputElement && el.type === "radio";
      const field = isRadio ? el.closest("fieldset") : el.closest("label");
      let valid = isRadio ? !!form.querySelector(`input[name="${el.name}"]:checked`) : el.checkValidity();
      field?.classList.toggle("bad", !valid);
      if (!valid) ok = false;
    });
    const profile = pane.querySelector<HTMLInputElement>('[name="profile"]');
    if (profile && profile.value.trim() && !/\w+\.\w+/.test(profile.value)) {
      profile.closest("label")?.classList.add("bad");
      ok = false;
    } else profile?.closest("label")?.classList.remove("bad");
    err.hidden = ok;
    if (!ok) pane.querySelector<HTMLElement>(".bad input, .bad select")?.focus();
    return ok;
  }

  function show(n: number) {
    step = n;
    panes.forEach((p) => (p.hidden = Number(p.dataset.pane) !== n));
    document.getElementById("stepn")!.textContent = String(n);
    (document.getElementById("pfill") as HTMLElement).style.width = `${(n / 3) * 100}%`;
    err.hidden = true;
    form.scrollIntoView({ behavior: "smooth", block: "start" });
    panes[n - 1].querySelector<HTMLElement>("input, select")?.focus({ preventScroll: true });
  }

  function notYetEligible() {
    status = "Not yet eligible";
    at = "Finished";
    send();
    try { sessionStorage.removeItem("af_sid"); } catch {}
    form.hidden = true;
    document.getElementById("notyet")!.hidden = false;
  }

  form.querySelectorAll("[data-next]").forEach((b) => b.addEventListener("click", () => {
    const pane = panes[step - 1];
    if (!checkPane(pane)) return;
    clearTimeout(timer);
    at = `Step ${step + 1}`;
    send();
    if (step === 2 && values().listings === notYet) return notYetEligible();
    show(step + 1);
  }));
  form.querySelectorAll("[data-back]").forEach((b) => b.addEventListener("click", () => show(step - 1)));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (step < 3) { (form.querySelector(`[data-pane="${step}"] [data-next]`) as HTMLElement)?.click(); return; }
    if (!checkPane(panes[2])) return;
    const v = values();
    at = "Finished";
    status = "Form done";
    clearTimeout(timer);
    send();
    // A second form in this same tab starts a new row (this visit keeps its id for the booking).
    try { sessionStorage.removeItem("af_sid"); } catch {}
    form.hidden = true;
    const frame = document.getElementById("cal") as HTMLIFrameElement;
    const cal = frame.dataset.calendly || "";
    if (cal) {
      const u = new URL(cal);
      u.searchParams.set("name", v.name);
      u.searchParams.set("email", v.email);
      u.searchParams.set("a1", v.phone);
      u.searchParams.set("embed_type", "Inline");
      u.searchParams.set("embed_domain", location.hostname);
      u.searchParams.set("hide_gdpr_banner", "1");
      frame.src = u.toString();
    } else {
      frame.src = frame.dataset.google || "";
    }
    const pick = document.getElementById("pick")!;
    pick.hidden = false;
    pick.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Calendly tells the page when a call is booked.
  addEventListener("message", (e) => {
    if (e.origin !== "https://calendly.com") return;
    if (e.data?.event === "calendly.event_scheduled") {
      status = "Booked";
      at = "Booked";
      send();
    }
  });
</script>

<style>
  .intro { padding-block: clamp(56px, 10vw, 100px) 40px; }
  .intro h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); max-width: 14ch; }
  .intro .lede { margin-top: 20px; font-size: clamp(1.05rem, 1.8vw, 1.2rem); }

  [hidden] { display: none !important; }
  .step { font-weight: 700; margin: 0 0 14px; }
  .note { color: var(--grey); margin: -6px 0 20px; }
  .video { border-radius: 14px; overflow: hidden; background: #000; aspect-ratio: 16 / 9; margin-bottom: 56px; }
  .video video { width: 100%; height: 100%; display: block; }

  .form { display: grid; gap: 18px; border: 1px solid var(--line); border-radius: 14px; padding: clamp(20px, 4vw, 32px); margin-bottom: 56px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 640px) { .row2 { grid-template-columns: 1fr; } }
  .form label, .form legend { display: grid; gap: 6px; font-weight: 600; font-size: .98rem; }
  .form fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .hint, .opt { color: var(--grey); font-weight: 400; font-size: .88rem; }
  .form input:not([type="radio"]), .form select {
    font: inherit; font-weight: 400; width: 100%; padding: 12px 14px; border: 1px solid #cfcfcf; border-radius: 8px; background: var(--paper); color: var(--ink);
  }
  .form input:focus, .form select:focus { outline: 2px solid var(--ink); outline-offset: 1px; }
  .choices { display: flex; flex-wrap: wrap; gap: 10px; }
  .form .choice { display: flex; align-items: center; gap: 8px; font-weight: 500; border: 1px solid #cfcfcf; border-radius: 8px; padding: 10px 14px; cursor: pointer; }
  .choice input { accent-color: var(--ink); }
  .bad input:not([type="radio"]), .bad select { border-color: var(--red); }
  .bad legend, fieldset.bad .choice { color: var(--red); border-color: var(--red); }
  .err { color: var(--red); font-weight: 600; margin: 0; }
  .form button { border: 0; font: inherit; font-weight: 700; cursor: pointer; }
  .pane { display: grid; gap: 18px; }
  .nav { display: flex; gap: 12px; align-items: center; }
  .back { background: none; color: var(--grey); padding: 12px 4px; text-decoration: underline; text-underline-offset: 3px; }
  .progress { display: grid; gap: 8px; font-size: .9rem; color: var(--grey); }
  .pbar { height: 4px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .pbar i { display: block; height: 100%; width: 33.34%; background: var(--ink); transition: width .25s ease; }
  .form .fine { margin-top: 0; }

  .notyet { border: 1px solid var(--line); border-radius: 14px; padding: clamp(20px, 4vw, 32px); margin-bottom: 56px; display: grid; gap: 12px; }
  .notyet h2 { font-size: 1.4rem; letter-spacing: -0.02em; }
  .notyet p { color: var(--grey); }

  .embed { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .embed iframe { width: 100%; height: 700px; border: 0; }
  @media (max-width: 640px) { .embed iframe { height: 900px; } }

  .fine { color: var(--grey); font-size: .85rem; margin-top: 14px; }
  .after { margin-top: 72px; }
  .wa { display: flex; width: fit-content; margin-top: 14px; }
</style>
