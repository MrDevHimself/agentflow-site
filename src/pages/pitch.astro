---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";

const GOOGLE_BOOKING_URL =
  "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1s9b6bxcsyzgHRuHrWrqKSvOYiVSpukN-JA4utaTzc0Hk54I0vTMgMA9V9sITcvtOoIuLgaRh4?gv=true";
const whatsapp = `https://wa.me/264816780891?text=${encodeURIComponent("Hey there, just booked a strategy call, looking forward to it.")}`;
---
<Base title="Book a strategy call · AgentFlow" description="Book a free 30-minute strategy call with AgentFlow.">
  <Nav booking />
  <main class="wrap">
    <div class="intro">
      <h1 class="display">Book your free strategy call.</h1>
      <p class="lede">30 minutes with us. We'll look at your market and show you how we'd fill your calendar with listing appointments.</p>
    </div>

    <div class="embed">
      <iframe src={GOOGLE_BOOKING_URL} title="Book a strategy call with AgentFlow" loading="lazy"></iframe>
    </div>
    <p class="fine">By booking, you agree that we can use your details to arrange your call, as set out in our <a href="/privacy">privacy policy</a>.</p>

    <section class="part after">
      <h2>After you book</h2>
      <ol class="items">
        <li><Icon name="mail" /><div><strong>1. Check your email</strong><span class="d">Google sends you a confirmation with the call link. Look in Spam if it's not there.</span></div></li>
        <li><Icon name="cal" /><div><strong>2. Save it to your calendar</strong><span class="d">The invite is already attached. Tap Yes so you don't miss it.</span></div></li>
        <li>
          <Icon name="chat" />
          <div>
            <strong>3. Confirm on WhatsApp</strong><span class="d">Send us a quick message so we know you're coming.</span>
            <a class="btn wa" href={whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>
          </div>
        </li>
      </ol>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro { padding-block: clamp(56px, 10vw, 100px) 40px; }
  .intro h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); max-width: 14ch; }
  .intro .lede { margin-top: 20px; font-size: clamp(1.05rem, 1.8vw, 1.2rem); }

  .embed { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .embed iframe { width: 100%; height: 680px; border: 0; }
  @media (max-width: 640px) { .embed iframe { height: 900px; } }

  .fine { color: var(--grey); font-size: .85rem; margin-top: 14px; }
  .after { margin-top: 72px; }
  .wa { display: flex; width: fit-content; margin-top: 14px; }
</style>
