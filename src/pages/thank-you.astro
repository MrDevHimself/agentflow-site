---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";

const WHATSAPP_NUMBER = "264816780891";
const WHATSAPP_MESSAGE = "Hey there, just scheduled an appointment, looking forward to it.";
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---
<Base title="You're booked · AgentFlow" description="Finish these three steps to confirm your call with AgentFlow.">
  <div class="banner" role="note">Keep this page open until you've finished all 3 steps below.</div>
  <header class="wrap bar narrow">
    <a href="/" aria-label="AgentFlow home"><Logo /></a>
  </header>

  <main class="wrap page">
    <h1>Your call is almost confirmed.</h1>
    <p class="lede">Three quick steps lock in your spot. It takes less than a minute.</p>

    <ol class="steps">
      <li>
        <h2>Check your email</h2>
        <p>We've sent a confirmation with the call details and a calendar invite.</p>
        <p class="muted small">Can't see it after a few minutes? Look in your Spam or Promotions folder.</p>
      </li>
      <li>
        <h2>Add the call to your calendar</h2>
        <p>Open the invite and tap <strong>Yes</strong> so the meeting is saved in your calendar.</p>
        <div class="invite" aria-hidden="true">
          <div>
            <strong>Discovery call with AgentFlow</strong>
            <span class="muted">Calendar invitation</span>
          </div>
          <div class="rsvp"><span class="yes">Yes</span><span>Maybe</span><span>No</span></div>
        </div>
      </li>
      <li class="key">
        <h2>Confirm on WhatsApp</h2>
        <p>Send us a quick message on WhatsApp. <strong>This is what locks in your spot.</strong> We'll reply to confirm.</p>
        <a class="btn wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.7-.3Z"/></svg>
          Confirm my call on WhatsApp
        </a>
      </li>
    </ol>

    <p class="help muted">Need help? Message us on WhatsApp at <a href={whatsappHref} target="_blank" rel="noopener noreferrer">+264 81 678 0891</a>.</p>
  </main>
</Base>

<style>
  .banner { background: var(--amber); color: #1A1204; text-align: center; padding: .7rem 1rem; font-weight: 650; font-size: .95rem; }
  .bar { height: 68px; display: flex; align-items: center; }
  .bar a { text-decoration: none; }
  .narrow { max-width: 720px; }

  .page { max-width: 720px; padding-block: clamp(2.5rem, 7vw, 4.5rem) 4rem; }
  .page h1 { font-size: clamp(2.3rem, 5.4vw, 3.6rem); }
  .page > .lede { margin-top: 1rem; }

  .steps { list-style: none; counter-reset: s; padding: 0; margin: 2.75rem 0 0; display: grid; gap: 1rem; }
  .steps li {
    counter-increment: s; position: relative;
    background: var(--panel); border: 1px solid var(--line); border-radius: 16px;
    padding: 1.6rem 1.6rem 1.6rem 4.6rem;
  }
  .steps li::before {
    content: counter(s); position: absolute; left: 1.5rem; top: 1.45rem;
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    display: grid; place-items: center; font-weight: 700;
    border: 1.5px solid var(--line); color: var(--text);
  }
  .steps li.key { border-color: var(--amber); }
  .steps li.key::before { background: var(--amber); border-color: var(--amber); color: #1A1204; }
  .steps h2 { font-size: 1.3rem; letter-spacing: -0.02em; margin-bottom: .5rem; }
  .small { font-size: .92rem; margin-top: .6rem; }

  .invite {
    margin-top: 1.1rem; padding: 1rem; border-radius: 12px; border: 1px solid var(--line); background: var(--night);
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
  }
  .invite strong, .invite span.muted { display: block; font-size: .92rem; }
  .rsvp { display: flex; gap: .4rem; }
  .rsvp span { font-size: .8rem; padding: .35rem .75rem; border-radius: 8px; border: 1px solid var(--line); color: var(--muted); }
  .rsvp .yes { background: var(--amber); border-color: var(--amber); color: #1A1204; font-weight: 700; }

  .wa { margin-top: 1.4rem; width: 100%; background: var(--whatsapp); color: #062B14; padding-block: 1.05rem; }
  .wa:hover { background: #3FE07C; }

  .help { text-align: center; margin-top: 2rem; font-size: .92rem; }
  .help a { color: var(--amber); }

  @media (max-width: 520px) {
    .steps li { padding: 4.2rem 1.3rem 1.4rem; }
    .steps li::before { left: 1.3rem; top: 1.3rem; }
  }
</style>
