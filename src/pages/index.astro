---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import WeekCard from "../components/WeekCard.astro";

const services = [
  { i: "ads", t: "Ads", d: "Facebook, Instagram and Google campaigns in your area." },
  { i: "call", t: "Calling", d: "Our team calls every lead within minutes and qualifies them." },
  { i: "follow", t: "Follow-up", d: "A CRM that keeps nurturing leads for up to 12 months." },
] as const;

const video = [
  { i: "video", t: "Your content", d: "We write the script, film you and edit it into videos for your ads and socials." },
  { i: "house", t: "Property videos", d: "We film the home room by room and edit it into a listing video that helps it sell." },
] as const;

const steps = [
  { i: "chat", t: "1. Strategy call", d: "We look at your market and what will work there." },
  { i: "rocket", t: "2. We launch", d: "Ads, pages and CRM go live in days." },
  { i: "cal", t: "3. You get appointments", d: "Qualified people show up in your calendar." },
] as const;
---
<Base>
  <Nav />
  <main>
    <div class="wrap hero">
      <div>
        <h1 class="display">Listing appointments, booked for you.</h1>
        <p class="lede">We run your ads, call every lead, and put qualified sellers and buyers in your calendar. In Windhoek, we film your videos too.</p>
        <a class="btn" href="/pitch">Book a free strategy call</a>
      </div>
      <WeekCard />
    </div>

    <div class="wrap">
      <section class="part">
        <h2>What we do</h2>
        <ul class="items">
          {services.map((s) => <li><Icon name={s.i} /><div><strong>{s.t}</strong><span class="d">{s.d}</span></div></li>)}
        </ul>
      </section>

      <section class="part">
        <div>
          <h2>Video</h2>
          <p class="where">Filmed in Windhoek</p>
        </div>
        <ul class="items">
          {video.map((s) => <li><Icon name={s.i} /><div><strong>{s.t}</strong><span class="d">{s.d}</span></div></li>)}
        </ul>
      </section>

      <section class="part">
        <h2>How it works</h2>
        <ol class="items">
          {steps.map((s) => <li><Icon name={s.i} /><div><strong>{s.t}</strong><span class="d">{s.d}</span></div></li>)}
        </ol>
      </section>

      <div class="cta">
        <h2>Ready for a fuller calendar?</h2>
        <a class="btn" href="/pitch">Book a free strategy call</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .hero { padding-block: clamp(72px, 14vw, 150px) clamp(72px, 12vw, 120px); display: grid; grid-template-columns: 1fr 250px; gap: 48px; align-items: start; }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; } }
  .hero h1 { max-width: 12ch; }
  .hero .lede { margin: 24px 0 36px; max-width: 30rem; }
  .cta { border-top: 1px solid var(--line); padding-block: 96px; text-align: center; }
  .cta h2 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.04em; font-weight: 800; line-height: 1.05; margin-bottom: 28px; }
</style>
