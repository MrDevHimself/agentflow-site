---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WeekCalendar from "../components/WeekCalendar.astro";

const flow = [
  { t: "Your ad runs", d: "Facebook, Instagram, YouTube and Google campaigns aimed at homeowners and buyers in your area." },
  { t: "A lead comes in", d: "They ask for a home value, a buyer guide or a callback. It lands in a CRM we set up for you." },
  { t: "We call them", d: "Our inside sales agents reach out within minutes and find out if they are ready to buy or sell." },
  { t: "It's on your calendar", d: "Qualified people get booked straight into your diary. Everyone else gets nurtured for up to 12 months." },
];

const services = [
  { t: "Lead generation", d: "Paid campaigns built to bring in motivated sellers and qualified buyers from your own market.", b: ["Multi-platform advertising", "Local targeting", "Weekly reporting"] },
  { t: "Inside sales agents", d: "Trained ISAs call, qualify and book your leads, so you only speak to people ready to move.", b: ["Fast first contact", "Ongoing follow-up", "Appointment booking"] },
  { t: "CRM and nurturing", d: "A CRM set up for you, with follow-up sequences that keep working your leads for a year or more.", b: ["Custom pipeline", "SMS and email automation", "Long-term nurture"] },
  { t: "Done-for-you marketing", d: "Landing pages, email campaigns and the whole funnel, built and managed by our team.", b: ["Landing pages", "Email campaigns", "Full management"] },
];

const steps = [
  { t: "Strategy call", d: "We look at your market, the sellers and buyers you want, and the offer that will work in your area." },
  { t: "We build and launch", d: "Our team makes the ads, pages and CRM. Your campaigns are live in days, not weeks." },
  { t: "Appointments arrive", d: "Qualified appointments show up in your calendar. You focus on winning the listing." },
];
---
<Base>
  <Nav />
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="for">For full-time real estate agents</p>
          <h1>Listing appointments in your calendar, every week.</h1>
          <p class="lede">We run your ads, call every lead and book qualified sellers and buyers straight into your diary. You stop waiting on referrals and start showing up to appointments.</p>
          <div class="ctas">
            <a class="btn btn-primary" href="/pitch">Book a free strategy call</a>
            <a class="btn btn-ghost" href="/services">See our services</a>
          </div>
        </div>
        <WeekCalendar />
      </div>
    </section>

    <section class="section flow-sec">
      <div class="wrap">
        <div class="sec-head">
          <h2>How a stranger becomes an appointment</h2>
          <p class="lede">Every lead goes through the same system, and none of it needs you until they're booked.</p>
        </div>
        <ol class="flow">
          {flow.map((f) => (
            <li>
              <span class="node" aria-hidden="true"></span>
              <h3>{f.t}</h3>
              <p class="muted">{f.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="wrap"><hr class="rule" /></div>

    <section class="section">
      <div class="wrap svc-layout">
        <div class="sec-head sticky">
          <h2>What we do for you</h2>
          <p class="lede">Everything is done in-house by our own team. Nothing gets handed off to freelancers.</p>
          <a class="text-link" href="/services">All services</a>
        </div>
        <div class="svc-list">
          {services.map((s) => (
            <article class="svc">
              <h3>{s.t}</h3>
              <p class="muted">{s.d}</p>
              <ul>{s.b.map((x) => <li>{x}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section start">
      <div class="wrap">
        <div class="sec-head">
          <h2>Getting started takes three steps</h2>
          <p class="lede">We handle the marketing. You handle the closings.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{s.t}</h3>
              <p class="muted">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section cta">
      <div class="wrap cta-inner">
        <h2>Ready for a fuller calendar?</h2>
        <p class="lede">Book a free 30-minute strategy call. We'll show you how the system would work in your market.</p>
        <a class="btn btn-primary" href="/pitch">Book my strategy call</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem); position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; top: 10%; right: -5%; width: 60%; height: 80%;
    background: radial-gradient(closest-side, rgba(242,179,61,.09), transparent 100%);
    pointer-events: none;
  }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: center; position: relative; }
  .for { color: var(--amber); font-weight: 600; margin-bottom: 1.25rem; }
  .hero h1 { max-width: 11ch; }
  .hero .lede { margin-top: 1.5rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }

  .sec-head { max-width: 40rem; }
  .sec-head .lede { margin-top: 1rem; }

  .flow { list-style: none; padding: 0; margin: 3.5rem 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; position: relative; }
  .flow::before {
    content: ""; position: absolute; top: 7px; left: 8px; right: 8px; height: 2px;
    background: linear-gradient(90deg, var(--line), var(--amber));
  }
  .flow li { position: relative; padding-top: 2.25rem; }
  .node { position: absolute; top: 0; left: 0; width: 16px; height: 16px; border-radius: 50%; background: var(--night); border: 2px solid var(--muted); }
  .flow li:last-child .node { background: var(--amber); border-color: var(--amber); box-shadow: 0 0 0 6px var(--amber-soft); }
  .flow h3 { margin-bottom: .6rem; }
  .flow p { font-size: .98rem; }

  .svc-layout { display: grid; grid-template-columns: 1fr 1.35fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .sticky { position: sticky; top: 110px; }
  .text-link { display: inline-block; margin-top: 1.5rem; color: var(--amber); font-weight: 600; text-underline-offset: 4px; }
  .svc-list { display: grid; }
  .svc { padding: 2rem 0; border-top: 1px solid var(--line); }
  .svc:first-child { border-top: 0; padding-top: 0; }
  .svc p { margin-top: .6rem; max-width: 34rem; }
  .svc ul { list-style: none; padding: 0; margin: 1.1rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .svc li { font-size: .85rem; padding: .3rem .7rem; border: 1px solid var(--line); border-radius: 999px; color: var(--text); }

  .start { background: var(--panel); border-block: 1px solid var(--line); }
  .steps { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .num { display: block; font-size: 3.5rem; font-weight: 750; line-height: 1; color: var(--amber); letter-spacing: -0.05em; margin-bottom: 1rem; }
  .steps p { margin-top: .5rem; }

  .cta-inner { text-align: center; display: grid; justify-items: center; gap: 1.25rem; }
  .cta-inner h2 { font-size: clamp(2.4rem, 5.5vw, 4.2rem); }
  .cta-inner .btn { margin-top: .75rem; }

  @media (max-width: 920px) {
    .hero-grid, .svc-layout { grid-template-columns: 1fr; }
    .hero h1 { max-width: 14ch; }
    .sticky { position: static; }
    .flow { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
    .flow::before { display: none; }
  }
  @media (max-width: 620px) {
    .flow, .steps { grid-template-columns: 1fr; }
  }
</style>
