---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const services = [
  { t: "Lead generation", d: "Paid ads across several channels, built to attract motivated sellers and qualified buyers in your local market.", f: ["Facebook and Instagram campaigns", "Google and YouTube search and display", "Tight local targeting", "Weekly performance reports"] },
  { t: "Inside sales agents", d: "Trained ISAs call, qualify and book your leads, so you only talk to people who are ready to buy or sell.", f: ["First contact within 5 minutes", "12-month follow-up cadence", "Pre-qualified appointments", "Live calendar booking"] },
  { t: "CRM and nurturing", d: "A CRM we set up for you, with automated SMS, email and voicemail sequences working your database around the clock.", f: ["Custom pipeline setup", "SMS and email automation", "Long-term nurture sequences", "Lead scoring and tagging"] },
  { t: "Brand and content", d: "Consistent, good-looking content that makes you the agent people think of first in your area.", f: ["Short-form video editing", "Listing reels and walkthroughs", "Branded ad creative", "Monthly content calendar"] },
  { t: "Email and SMS", d: "Regular, personal broadcasts that keep you in front of your sphere and bring listings back to you.", f: ["Database reactivation campaigns", "Monthly market updates", "Holiday and event broadcasts", "A/B tested templates"] },
  { t: "Funnels and landing pages", d: "Pages and offers like home value checks, listing alerts and buyer guides, built and managed for you.", f: ["Home value funnels", "Buyer and seller guide funnels", "Designed to convert", "Lead capture built in"] },
];

const oldWay = [
  "Buying recycled leads from portals",
  "Chasing cold leads who never answer",
  "Juggling three different freelancers",
  "Months of trial and error",
  "Nobody accountable for results",
];
const ourWay = [
  "Exclusive leads generated only for you",
  "ISAs qualify people before they reach your calendar",
  "One team, one accountable partner",
  "Live in days, not months",
  "Clear weekly reporting on what's working",
];
---
<Base title="Services · AgentFlow" description="Lead generation, inside sales agents, CRM, content, email and funnels for real estate agents, all run in-house by AgentFlow.">
  <Nav />
  <main>
    <section class="intro">
      <div class="wrap">
        <h1>Your whole marketing department, run for you.</h1>
        <p class="lede">From the first ad someone sees to the appointment in your calendar, our team runs every part of it.</p>
        <a class="btn btn-primary" href="/pitch">Book a strategy call</a>
      </div>
    </section>

    <section class="wrap list" aria-label="Services">
      {services.map((s) => (
        <article class="row">
          <h2>{s.t}</h2>
          <div>
            <p class="desc">{s.d}</p>
            <ul>{s.f.map((x) => <li>{x}</li>)}</ul>
          </div>
        </article>
      ))}
    </section>

    <section class="section compare-sec">
      <div class="wrap">
        <h2 class="c-title">Why agents switch to AgentFlow</h2>
        <div class="compare">
          <div class="side old">
            <h3>Doing it the usual way</h3>
            <ul>{oldWay.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="side new">
            <h3>With AgentFlow</h3>
            <ul>{ourWay.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap cta">
        <h2>Let's build your growth engine.</h2>
        <p class="lede">Book a free 30-minute strategy call and we'll show you which services would make the biggest difference in your market.</p>
        <a class="btn btn-primary" href="/pitch">Book my strategy call</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 6vw, 4.5rem); }
  .intro h1 { max-width: 14ch; }
  .intro .lede { margin: 1.5rem 0 2.25rem; }

  .list { padding-bottom: clamp(3rem, 8vw, 6rem); }
  .row {
    display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem;
    padding-block: 2.5rem; border-top: 1px solid var(--line);
  }
  .row h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); }
  .desc { font-size: 1.1rem; max-width: 36rem; }
  .row ul { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .55rem 1.5rem; }
  .row li { color: var(--muted); padding-left: 1.1rem; position: relative; font-size: .97rem; }
  .row li::before { content: ""; position: absolute; left: 0; top: .62em; width: 6px; height: 6px; border-radius: 50%; background: var(--amber); }

  .compare-sec { background: var(--panel); border-block: 1px solid var(--line); }
  .c-title { max-width: 16ch; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 3rem; }
  .side { border-radius: 16px; padding: 2rem; }
  .old { border: 1px solid var(--line); }
  .new { background: var(--night); border: 1px solid var(--amber); }
  .side ul { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: .8rem; }
  .side li { padding-left: 1.6rem; position: relative; }
  .old li { color: var(--muted); }
  .old li::before { content: "×"; position: absolute; left: 0; color: #7D8AA0; font-weight: 700; }
  .new li::before { content: "✓"; position: absolute; left: 0; color: var(--amber); font-weight: 700; }
  .new h3 { color: var(--amber); }

  .cta { text-align: center; display: grid; justify-items: center; gap: 1.25rem; }
  .cta .btn { margin-top: .75rem; }

  @media (max-width: 800px) {
    .row, .compare { grid-template-columns: 1fr; }
    .row { gap: 1rem; }
  }
  @media (max-width: 480px) { .row ul { grid-template-columns: 1fr; } }
</style>
